<AuthLayout.auth_layout subtitle="Authorization Required">
  <:header_icon>
    <img src={~p"/images/zaq.png"} alt="ZAQ" class="zaq-auth-logo-img" />
  </:header_icon>

  <div
    :if={Phoenix.Flash.get(@flash, :error)}
    id="auth-login-error"
    class="zaq-feedback-banner zaq-danger zaq-text-body zaq-feedback-banner--shake"
  >
    <span class="zaq-feedback-icon">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
      </svg>
    </span>
    <span class="zaq-feedback-body">{Phoenix.Flash.get(@flash, :error)}</span>
  </div>

  <.form
    for={@form}
    id="bo-login-form"
    action={~p"/bo/session"}
    method="post"
    phx-change="validate"
    class="zaq-layout-stack"
  >
    <DSInput.input
      name="username"
      label="Username or Email"
      value={@form[:username].value}
      required
      placeholder="username or email"
    />

    <DSSecretInput.secret_input
      id="login-password"
      name="password"
      label="Password"
      value={@form[:password].value}
      required
      placeholder="••••••••"
    />

    <div class="zaq-auth-form-actions">
      <DSCheckbox.checkbox
        name="remember"
        label="KEEP ME LOGGED IN"
        form_hidden={false}
        class="zaq-bo-checkbox zaq-focus-visible"
      />
      <DSLink.nav_link
        destination={~p"/bo/forgot-password"}
        tone={:accent}
        external={true}
        size={:sm}
      >
        Forgot password?
      </DSLink.nav_link>
    </div>

    <DSButton.button type="submit" variant={:primary} class="w-full uppercase">
      Sign In to Dashboard
    </DSButton.button>
  </.form>

  <:footer>
    <p class="zaq-text-caption uppercase" style="color: var(--zaq-text-color-body-tertiary)">
      ZAQ Back Office &copy; {Date.utc_today().year} |
      <DSLink.nav_link destination="https://zaq.ai" tone={:accent} external={true} size={:sm}>
        zaq.ai
      </DSLink.nav_link>
    </p>
  </:footer>
</AuthLayout.auth_layout>
