<AuthLayout.auth_layout subtitle="Password Reset">
  <:header_icon>
    <img src={~p"/images/zaq.png"} alt="ZAQ" class="zaq-auth-logo-img" />
  </:header_icon>

  <%= if @submitted do %>
    <EmptyState.empty_state variant={:success} title="Check your inbox">
      <:details>
        If an account with that email exists, we've sent a password reset link.
        The link is valid for <strong>1 hour</strong>.
      </:details>
      <:action>
        <DSLink.nav_link destination={~p"/bo/login"} tone={:accent} external={true} size={:sm}>
          Back to Sign In
        </DSLink.nav_link>
      </:action>
    </EmptyState.empty_state>
  <% else %>
    <p class="zaq-text-body zaq-auth-intro" style="color: var(--zaq-text-color-body-secondary)">
      Enter your account email address and we'll send you a link to reset your password.
    </p>

    <div
      :if={@error}
      id="auth-forgot-error"
      class="zaq-feedback-banner zaq-danger zaq-text-body"
    >
      <span class="zaq-feedback-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
        </svg>
      </span>
      <span class="zaq-feedback-body">{@error}</span>
    </div>

    <.form
      for={@form}
      id="forgot-password-form"
      phx-submit="send_reset"
      phx-change="validate"
      class="zaq-layout-stack"
    >
      <DSInput.input
        name="email"
        type="email"
        label="Email Address"
        value={@form[:email].value}
        required
        placeholder="e.g. you@company.com"
      />

      <DSButton.button type="submit" variant={:primary} class="w-full uppercase">
        Send Reset Link
      </DSButton.button>
    </.form>

    <div class="zaq-auth-back-link-row">
      <DSLink.nav_link destination={~p"/bo/login"} external={true} size={:sm}>
        Back to Sign In
      </DSLink.nav_link>
    </div>
  <% end %>
</AuthLayout.auth_layout>
