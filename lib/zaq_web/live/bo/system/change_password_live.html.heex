<AuthLayout.auth_layout
  heading="Change Password"
  subtitle="You must set a new password before continuing"
>
  <:header_icon>
    <img src={~p"/images/zaq.png"} alt="ZAQ" class="zaq-auth-logo-img" />
  </:header_icon>

  <div
    :if={@error_message}
    id="change-password-error"
    class="zaq-feedback-banner zaq-danger zaq-text-body"
  >
    <span class="zaq-feedback-icon">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
      </svg>
    </span>
    <span class="zaq-feedback-body">{@error_message}</span>
  </div>

  <.form
    for={@form}
    id="change-password-form"
    phx-submit="change_password"
    phx-change="validate"
    class="zaq-layout-stack"
  >
    <DSInput.input
      :if={Zaq.Helpers.blank?(@user.email)}
      id="email"
      type="email"
      name="email"
      label="Email"
      value={@form[:email].value}
      phx-debounce="300"
      placeholder="admin@example.com"
      required
    />

    <div>
      <DSSecretInput.secret_input
        id="password"
        name="password"
        label="New Password"
        value={@form[:password].value}
        phx-debounce="300"
        placeholder="Min 8 chars with upper/lower/number/symbol"
        required
      />

      <ZaqWeb.Components.PasswordPolicyComponents.password_requirements requirements={
        @password_requirements
      } />
    </div>

    <div>
      <DSSecretInput.secret_input
        id="password-confirmation"
        name="password_confirmation"
        label="Confirm Password"
        value={@form[:password_confirmation].value}
        phx-debounce="300"
        placeholder="Repeat password"
        required
        hint={
          PasswordHelpers.confirmation_hint_text(
            @password_confirmation_touched?,
            @passwords_match?
          )
        }
        hint_tone={
          PasswordHelpers.confirmation_hint_tone(
            @password_confirmation_touched?,
            @passwords_match?
          )
        }
        hint_id="password-confirmation-status"
      />
    </div>

    <div>
      <DSButton.button
        type="submit"
        variant={:primary}
        class="w-full uppercase"
        disabled={!@password_requirements_met? or !@passwords_match? or @portal_loading}
        loading={@portal_loading}
        loading_label="Checking…"
      >
        Set Password
      </DSButton.button>

      <p
        :if={!@password_requirements_met? or !@passwords_match?}
        class="zaq-text-caption"
        style="color: var(--zaq-text-color-body-tertiary)"
      >
        Complete all requirements and confirm the password to continue.
      </p>
    </div>
  </.form>

  <:footer>
    <p class="zaq-text-caption uppercase" style="color: var(--zaq-text-color-body-tertiary)">
      ZAQ Back Office &copy; {@current_year} |
      <DSLink.nav_link destination="https://zaq.ai" tone={:accent} external={true} size={:sm}>
        zaq.ai
      </DSLink.nav_link>
    </p>
  </:footer>
</AuthLayout.auth_layout>

<ZaqWeb.Components.PortalConsentModal.portal_consent_modal
  show={@show_consent_modal}
  metadata={@portal_metadata}
  on_accept="accept_portal_consent"
  on_decline="decline_portal_consent"
/>

<ZaqWeb.Components.PortalConsentModal.portal_post_accept_modal
  show={@show_post_accept_modal}
  post_accept={(@portal_metadata || %{})["post_accept"]}
  on_close="close_post_accept_modal"
/>
